---
layout: null
permalink: /manifest-orcamento.webmanifest
---
{
  "name": "Ferramentas Wisky 3D Print",
  "short_name": "Wisky 3D",
  "description": "Calculadora de orçamento e conversor de projetos 3MF para impressão 3D.",
  "start_url": "{{ '/orcamento/' | relative_url }}",
  "scope": "{{ '/' | relative_url }}",
  "display": "standalone",
  "background_color": "#070b12",
  "theme_color": "#070b12",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "{{ '/assets/img/icon-orcamento-192.png' | relative_url }}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{{ '/assets/img/icon-orcamento-512.png' | relative_url }}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
